{
  "name": "treedoc",
  "version": "0.3.51",
  "description": "JSONex TreeDoc Json Parser",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.js\"",
    "lint": "tslint -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "npm run lint",
    "version": "git add -A src",
    "postversion": "git push && git push --tags",
    "npm-install": "npm install --no-bin-links"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jianwu/jsonextreedoc_ts.git"
  },
  "bugs": {
    "url": "https://github.com/jianwu/jsonextreedoc_ts/issues"
  },
  "keywords": [
    "jsonex",
    "json5",
    "hjson",
    "prototext",
    "json configuration",
    "configuration",
    "typescript"
  ],
  "author": "Jianwu Chen",
  "license": "MIT",
  "homepage": "https://github.com/jianwu/jsonextreedoc_ts/#readme",
  "devDependencies": {
    "@types/node": "^22.15.21",
    "codecov": "^3.6.1",
    "prettier": "^3.5.3",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  },
  "files": [
    "lib/**/*"
  ]
}
